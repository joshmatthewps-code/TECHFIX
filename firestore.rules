rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Must match RESEARCHER_EMAILS in js/game.js
    function isResearcher() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             "gerichorelox96@gmail.com",
             "glydelmanzano22@gmail.com"
           ];
    }

    function oldP()     { return resource.data.get('P', {}); }
    function newP()     { return request.resource.data.get('P', {}); }
    function oldTests() { return oldP().get('tests', {}); }
    function newTests() { return newP().get('tests', {}); }

    // Once a pre/post-test exists it can no longer be changed or removed.
    function frozen(k) {
      return !(k in oldTests()) || (k in newTests() && newTests()[k] == oldTests()[k]);
    }
    function surveyFrozen() {
      return !('survey' in oldP()) || ('survey' in newP() && newP().survey == oldP().survey);
    }

    match /players/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isResearcher());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
                    && frozen('pre') && frozen('post') && surveyFrozen();
      allow delete: if false;

      // every solved problem in the Desktop simulator (audit trail)
      match /desk/{rid} {
        allow read:   if signedIn() && (request.auth.uid == uid || isResearcher());
        allow create: if signedIn() && request.auth.uid == uid
                      && request.resource.data.uid == uid
                      && request.resource.data.score is number
                      && request.resource.data.score >= 0
                      && request.resource.data.score <= 100;
        allow update, delete: if false;
      }
    }

    match /leaderboard/{uid} {
      allow read:   if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly(['name','points','solved','level','updatedAt'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 16
                      && request.resource.data.points is number
                      && request.resource.data.points >= 0
                      && request.resource.data.points <= 2500
                      && request.resource.data.solved is number
                      && request.resource.data.solved <= 25;
      allow delete: if false;
    }
  }
}
